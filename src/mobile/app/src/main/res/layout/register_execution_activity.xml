<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activitys_javaclass.RegisterExecutionActivity"
    android:background="@color/lightgrey">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-12dp">

        <LinearLayout
            android:id="@+id/blueSquare"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@drawable/rounded"
            android:backgroundTint="@color/lightblue"
            android:orientation="vertical"
            android:padding="24dp">

        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/confirmar_execucao"
        android:textSize="26sp"
        android:fontFamily="@font/roboto_medium"
        android:textColor="@color/white"
        android:layout_marginTop="15dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/blueSquare"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@drawable/rounded"
            android:layout_margin="10dp"
            android:padding="10dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/exerciseName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Teste Nome de exercício"
                android:textSize="20sp"
                android:fontFamily="@font/roboto_medium"
                android:textColor="@color/black"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"/>

            <TextView
                android:id="@+id/exerciseFrequency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Frequência do exercício"
                android:textSize="15sp"
                android:fontFamily="@font/roboto_medium"
                android:textColor="@color/grey"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="10dp"/>

        </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/blueSquare"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/rounded"
        android:layout_marginHorizontal="10dp"
        android:padding="10dp"
        android:elevation="4dp"
        android:layout_marginBottom="130dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/niveis_dor"
            android:textSize="20sp"
            android:fontFamily="@font/roboto_medium"
            android:textColor="@color/black"
            android:layout_marginStart="10dp">
        </TextView>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/scalePain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn1Pain"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/sem_dor"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:layout_marginVertical="6dp"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/green"
                app:elevation="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn2Pain"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/dor_leve_ou_amena"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:layout_marginVertical="6dp"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/yellow"
                app:elevation="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn3Pain"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/dor_moderada"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:layout_marginVertical="6dp"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/salmon"
                app:elevation="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn4Pain"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/dor_intensa"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:layout_marginVertical="6dp"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/red"
                app:elevation="4dp"/>

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.button.MaterialButton

            android:id="@+id/btnRegisterExecution"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/registrar_execução"
            android:textColor="@color/white"
            android:fontFamily="@font/roboto_medium"
            android:background="@drawable/rounded_button"
            app:backgroundTint="@null"
            android:textSize="17sp"
            android:layout_margin="10dp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>