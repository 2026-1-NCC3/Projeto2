<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightgrey"
    tools:context=".activitys_javaclass.RegisterExecutionCompletedActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/centerBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/frameSuccess"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/circle_background"
            android:backgroundTint="@color/lightgreen"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/ic_check_rounded"
                android:layout_gravity="center"
                android:contentDescription="@string/icone_exercicio_registrado"/>
        </FrameLayout>

        <TextView
            android:id="@+id/tvTitleSuccess"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/exercicio_registrado"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/frameSuccess"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvSubtitleSuccess"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/parabens_manter_rotina"
            android:textSize="15sp"
            android:textColor="@color/grey"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitleSuccess"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>