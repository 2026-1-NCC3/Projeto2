<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightgrey"
    tools:context=".activitys_javaclass.ExercisesDescriptionActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Botão voltar com nome do exercício -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackExercises"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Exercício"
                android:textColor="@color/black"
                app:icon="@drawable/ic_arrow_back"
                app:iconTint="@color/black"
                app:iconSize="25dp"
                android:background="@android:color/transparent"
                android:textSize="18sp"
                android:fontFamily="@font/roboto_medium"
                android:layout_marginStart="10dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- WebView 16:9 para o YouTube -->
            <WebView
                android:id="@+id/wvYoutube"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="10dp"
                app:layout_constraintDimensionRatio="H,16:9"
                app:layout_constraintTop_toBottomOf="@id/btnBackExercises"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Card frequência -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardFrequencyDetail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/rounded"
                android:elevation="4dp"
                android:padding="15dp"
                app:layout_constraintTop_toBottomOf="@id/wvYoutube"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/iconFreq"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    app:srcCompat="@drawable/ic_exclamation"
                    app:tint="@color/babyblue"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Frequência"
                    android:textSize="14sp"
                    android:textColor="@color/grey"
                    android:layout_marginStart="10dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iconFreq" />

                <TextView
                    android:id="@+id/tvFrequencyDetail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/roboto_medium"
                    android:gravity="end"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Card descrição -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardDescriptionDetail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/rounded"
                android:padding="15dp"
                android:elevation="4dp"
                app:layout_constraintTop_toBottomOf="@id/cardFrequencyDetail"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Descrição"
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/roboto_medium"
                    android:id="@+id/titleDescCard"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/exerciseDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="15sp"
                    android:textColor="@color/grey"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="6dp"
                    app:layout_constraintTop_toBottomOf="@id/titleDescCard"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Card instruções (como executar) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardInstructions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/rounded"
                android:padding="15dp"
                android:elevation="4dp"
                app:layout_constraintTop_toBottomOf="@id/cardDescriptionDetail"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/titleInstructions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Como executar"
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/roboto_medium"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tvInstructions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="15sp"
                    android:textColor="@color/grey"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/titleInstructions"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Card escala de dor + botão de registro -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardPain"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:background="@drawable/rounded"
                android:layout_margin="10dp"
                android:padding="10dp"
                android:elevation="4dp"
                app:layout_constraintTop_toBottomOf="@id/cardInstructions"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvPainTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/niveis_dor"
                    android:textSize="20sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/roboto_medium"
                    android:layout_marginStart="10dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/scalePain"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:checkedButton="@id/btn1Pain"
                    app:layout_constraintTop_toBottomOf="@id/tvPainTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn1Pain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sem_dor"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"
                        android:layout_marginVertical="6dp"
                        app:cornerRadius="24dp"
                        app:backgroundTint="@color/green"
                        app:elevation="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn2Pain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dor_leve_ou_amena"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:textColor="@android:color/black"
                        android:layout_marginVertical="6dp"
                        app:cornerRadius="24dp"
                        app:backgroundTint="@color/yellow"
                        app:elevation="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn3Pain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dor_moderada"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"
                        android:layout_marginVertical="6dp"
                        app:cornerRadius="24dp"
                        app:backgroundTint="@color/salmon"
                        app:elevation="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn4Pain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dor_intensa"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"
                        android:layout_marginVertical="6dp"
                        app:cornerRadius="24dp"
                        app:backgroundTint="@color/red"
                        app:elevation="4dp" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegisterExecution"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Registrar Execução"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:fontFamily="@font/roboto_medium"
                    android:background="@drawable/rounded_button"
                    app:backgroundTint="@null"
                    android:layout_margin="10dp"
                    app:layout_constraintTop_toBottomOf="@id/scalePain"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>