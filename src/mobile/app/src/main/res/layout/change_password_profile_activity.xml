<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightgrey"
    tools:context=".activitys_javaclass.ChangePasswordProfileActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardChangePasswordProfile"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:elevation="6dp"
        android:background="@drawable/rounded"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alterar_minha_senha"
            android:textColor="@color/lightblue"
            android:textSize="15sp"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/txtCurrentPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/insira_a_senha_atual"
            android:textColor="@color/grey"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/txtTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <EditText
            android:id="@+id/editPasswordProfile"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:hint="@string/preencher_senha"
            android:inputType="textPassword"
            android:autofillHints="password"
            android:textSize="15sp"
            android:fontFamily="@font/roboto_medium"
            android:background="@drawable/rounded"
            android:backgroundTint="@color/lightgrey"
            android:padding="10dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/txtCurrentPassword"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/txtNewPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/insira_uma_nova_senha"
            android:textColor="@color/grey"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/editPasswordProfile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <EditText
            android:id="@+id/editNewPasswordProfile"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:hint="@string/preencher_senha"
            android:inputType="textPassword"
            android:autofillHints="password"
            android:textSize="15sp"
            android:fontFamily="@font/roboto_medium"
            android:background="@drawable/rounded"
            android:backgroundTint="@color/lightgrey"
            android:padding="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/txtNewPassword"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/txtConfirmPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/confirme_sua_senha"
            android:textColor="@color/grey"
            android:fontFamily="@font/roboto_medium"
            app:layout_constraintTop_toBottomOf="@id/editNewPasswordProfile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <EditText
            android:id="@+id/editConfirmNewPasswordProfile"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:hint="@string/preencher_senha"
            android:inputType="textPassword"
            android:autofillHints="password"
            android:textSize="15sp"
            android:fontFamily="@font/roboto_medium"
            android:background="@drawable/rounded"
            android:backgroundTint="@color/lightgrey"
            android:padding="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/txtConfirmPassword"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangePasswordProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/alterar_a_senha"
            android:textColor="@color/white"
            android:fontFamily="@font/roboto_medium"
            app:backgroundTint="@color/lightblue"
            app:layout_constraintTop_toBottomOf="@id/editConfirmNewPasswordProfile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>