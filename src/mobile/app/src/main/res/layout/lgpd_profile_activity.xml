<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightgrey"
    tools:context=".activitys_javaclass.LgpdProfileActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardLgpd"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:background="@drawable/rounded"
        android:elevation="6dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvTitleLgpd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/termo_consentimento_LGPD"
            android:textColor="@color/lightblue"
            android:textSize="20sp"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginTop="10dp"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvSubtitleLgpd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/leitura_termo_LGPD"
            android:textColor="@color/grey"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginTop="10dp"

            app:layout_constraintTop_toBottomOf="@id/tvTitleLgpd"
            app:layout_constraintStart_toStartOf="parent"/>

        <ScrollView
            android:id="@+id/scrollLgpd"
            android:layout_width="0dp"
            android:layout_height="400dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded"
            android:backgroundTint="@color/lightgrey"
            android:padding="8dp"
            android:scrollbars="vertical"

            app:layout_constraintTop_toBottomOf="@id/tvSubtitleLgpd"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/txtTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/grey"
                android:lineSpacingExtra="4dp"
                android:text="@string/termos_LGPD_mais_informações_maya"
                android:fontFamily="@font/roboto_medium"/>
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackTermProfile"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginTop="10dp"
            android:text="@string/voltar"
            android:textSize="12sp"
            android:fontFamily="@font/roboto_medium"
            android:padding="0dp"
            app:backgroundTint="@color/lightblue"

            app:layout_constraintTop_toBottomOf="@id/scrollLgpd"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>