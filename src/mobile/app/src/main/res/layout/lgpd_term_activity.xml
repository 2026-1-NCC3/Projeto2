<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightgrey"
    tools:context=".activitys_javaclass.LgpdTermActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardLgpd"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:elevation="6dp"
        android:background="@drawable/rounded"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/termo_consentimento_LGPD"
            android:textColor="@color/lightblue"
            android:textSize="20sp"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/txtDescricao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/leitura_termo_LGPD_primeira_vez"
            android:textColor="@color/grey"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/txtTitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ScrollView
            android:id="@+id/scrollLgpd"
            android:layout_width="0dp"
            android:layout_height="300dp"
            android:layout_marginTop="16dp"
            android:scrollbars="vertical"
            android:background="@drawable/rounded"
            android:backgroundTint="@color/lightgrey"
            android:padding="8dp"
            app:layout_constraintTop_toBottomOf="@id/txtDescricao"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/txtTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:textSize="14sp"
                android:textColor="@color/grey"
                android:lineSpacingExtra="4dp"
                android:text="@string/termos_LGPD_mais_informações_maya"
                android:fontFamily="@font/roboto_medium"/>
        </ScrollView>

        <CheckBox
            android:id="@+id/checkBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/leu_os_termos"
            android:textColor="@color/grey"
            android:fontFamily="@font/roboto_medium"
            android:padding="5dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/rounded"
            android:backgroundTint="@color/lightgrey"
            app:layout_constraintTop_toBottomOf="@id/scrollLgpd"
            app:layout_constraintStart_toStartOf="parent"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackLogin"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:text="@string/voltar"
            android:textSize="12sp"
            android:textColor="@color/grey"
            android:fontFamily="@font/roboto_medium"
            android:background="@drawable/rounded_button"
            app:backgroundTint="@color/lightgrey"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintTop_toBottomOf="@id/checkBox"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnAcceptTerms"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAcceptTerms"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:text="@string/continuar"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:fontFamily="@font/roboto_medium"
            android:background="@drawable/rounded_button"
            app:backgroundTint="@null"
            android:layout_marginTop="10dp"
            android:layout_marginStart="4dp"
            app:layout_constraintTop_toBottomOf="@id/checkBox"
            app:layout_constraintStart_toEndOf="@id/btnBackLogin"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>