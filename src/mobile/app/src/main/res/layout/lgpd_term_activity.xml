<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightgrey"
    tools:context=".activitys_javaclass.LgpdTermActivity">

    <LinearLayout
        android:id="@+id/cardLgpd"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_centerHorizontal="true"
        android:layout_centerInParent="true"
        android:elevation="6dp"
        android:background="@drawable/rounded">

        <TextView
            android:layout_marginTop="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/termo_consentimento_LGPD"
            android:textColor="@color/lightblue"
            android:textSize="20sp"
            android:fontFamily="@font/roboto_medium"/>

        <TextView
            android:layout_marginTop="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/leitura_termo_LGPD_primeira_vez"
            android:textColor="@color/grey"
            android:fontFamily="@font/roboto_medium"/>

        <ScrollView
            android:id="@+id/scrollLgpd"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="16dp"
            android:scrollbars="vertical"
            android:background="@drawable/rounded"
            android:backgroundTint="@color/lightgrey"
            android:padding="8dp">

            <TextView
                android:id="@+id/txtTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:textSize="14sp"
                android:textColor="@color/grey"
                android:lineSpacingExtra="4dp"
                android:text="@string/termos_LGPD_mais_informações_maya"
                android:fontFamily="@font/roboto_medium"/>
        </ScrollView>

        <CheckBox
            android:id="@+id/checkBox"
            android:layout_width="wrap_content"
            android:padding="5dp"
            android:layout_height="wrap_content"
            android:text="@string/leu_os_termos"
            android:fontFamily="@font/roboto_medium"
            android:textColor="@color/grey"
            android:layout_marginTop="10dp"
            android:background="@drawable/rounded"
            android:backgroundTint="@color/lightgrey"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackLogin"
                android:padding="0dp"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/voltar"
                android:textSize="12sp"
                android:textColor="@color/grey"
                android:fontFamily="@font/roboto_medium"
                android:background="@drawable/rounded_button"
                app:backgroundTint="@color/lightgrey"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcceptTerms"
                android:padding="0dp"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/continuar"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:fontFamily="@font/roboto_medium"
                android:background="@drawable/rounded_button"
                app:backgroundTint="@null"/>

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>