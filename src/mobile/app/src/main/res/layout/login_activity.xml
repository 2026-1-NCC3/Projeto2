<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightgrey"
    tools:context=".activitys_javaclass.LoginActivity">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="300dp"
        android:layout_height="120dp"
        android:src="@drawable/maya_logo"
        android:contentDescription="@string/logo_maya"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardLogin"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:background="@drawable/rounded"
        android:elevation="6dp"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toBottomOf="@id/imageView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ======== CAMPO E-MAIL ======== -->
        <TextView
            android:id="@+id/txtEmailLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/e_mail"
            android:textColor="@color/grey"
            android:fontFamily="@font/roboto_medium"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emailInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/rounded"
            android:backgroundTint="@color/lightgrey"
            app:boxBackgroundMode="none"
            app:hintEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/txtEmailLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editEmail"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:hint="@string/seu_email"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"
                android:textSize="15sp"
                android:fontFamily="@font/roboto_medium"
                android:background="@android:color/transparent"
                android:padding="10dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ======== CAMPO SENHA ======== -->
        <TextView
            android:id="@+id/txtSenhaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/senha"
            android:textColor="@color/grey"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/emailInputLayout"
            app:layout_constraintStart_toStartOf="parent"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passwordToggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/rounded"
            android:backgroundTint="@color/lightgrey"
            app:boxBackgroundMode="none"
            app:hintEnabled="false"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/grey"
            app:layout_constraintTop_toBottomOf="@id/txtSenhaLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editPassword"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:hint="@string/preencher_senha"
                android:inputType="textPassword"
                android:textSize="15sp"
                android:fontFamily="@font/roboto_medium"
                android:background="@android:color/transparent"
                android:padding="10dp"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ======== BOTÕES ======== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/entrar"
            android:textColor="@color/white"
            android:fontFamily="@font/roboto_medium"
            android:backgroundTint="@color/lightblue"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/passwordToggle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/btnForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/esqueci_senha"
            android:textColor="@color/lightblue"
            android:fontFamily="@font/roboto_medium"
            android:backgroundTint="@color/white"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/btnLogin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/txtVersao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/versão_app"
        android:textColor="@color/lightblue"
        android:fontFamily="@font/roboto_medium"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>